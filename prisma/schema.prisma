generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(uuid())
  name      String
  email     String     @unique
  password  String

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  customers Customer[]
}

model Customer {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  company   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    String
  user      User     @relation(fields: [userId], references: [id])
}